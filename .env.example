# --- Сервер -------------------------------------------------------------
VAULT_HOST=127.0.0.1
VAULT_PORT=8000
VAULT_DEBUG=false

# --- Дані ---------------------------------------------------------------
# За замовчуванням база лежить у <корінь проєкту>/var
# VAULT_DATA_DIR=./var
# VAULT_DB=./var/vault.sqlite3

# --- Паролі -------------------------------------------------------------
VAULT_HASH_ROUNDS=12

# --- JWT ----------------------------------------------------------------
# Не коротше 32 символів. Згенерувати:
# python -c "import secrets; print(secrets.token_hex(32))"
VAULT_JWT_SECRET=
