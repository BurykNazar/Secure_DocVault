# --- Сервер -------------------------------------------------------------
VAULT_HOST=127.0.0.1
VAULT_PORT=8000
VAULT_DEBUG=false

# --- Дані ---------------------------------------------------------------
# За замовчуванням усе лежить у <корінь проєкту>/var
# VAULT_DATA_DIR=./var
# VAULT_DB=./var/vault.sqlite3
# VAULT_LOG_DIR=./var/logs

# --- Паролі та блокування ----------------------------------------------
VAULT_HASH_ROUNDS=12
VAULT_MAX_FAILURES=5
VAULT_LOCK_MINUTES=15
