# --- Сервер -------------------------------------------------------------
VAULT_HOST=127.0.0.1
VAULT_PORT=8000
VAULT_DEBUG=false

# --- Дані ---------------------------------------------------------------
# За замовчуванням база лежить у <корінь проєкту>/var
# VAULT_DATA_DIR=./var
# VAULT_DB=./var/vault.sqlite3

# --- Паролі -------------------------------------------------------------
VAULT_HASH_ROUNDS=12

# --- JWT ----------------------------------------------------------------
# Не коротше 32 символів. Згенерувати:
# python -c "import secrets; print(secrets.token_hex(32))"
VAULT_JWT_SECRET=

# --- Файли --------------------------------------------------------------
# 64 hex-символи (256 біт). Згенерувати:
# python -c "import secrets; print(secrets.token_hex(32))"
VAULT_FILE_KEY=

# --- ЕЦП ----------------------------------------------------------------
# 64 hex-символи (256 біт). Окремий ключ для приватних ключів підпису.
VAULT_SIGNING_KEY=

# --- Cookie та CORS -----------------------------------------------------
# Secure=true для HTTPS/localhost. Для HTTP-демо на 127.0.0.1 — false.
VAULT_COOKIE_SECURE=true
VAULT_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
